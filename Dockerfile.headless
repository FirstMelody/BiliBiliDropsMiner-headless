FROM node:22-bookworm-slim
WORKDIR /app
RUN apt-get update && apt-get install -y --no-install-recommends python3 python3-venv \
    && rm -rf /var/lib/apt/lists/*
COPY package.json package-lock.json ./
RUN npm ci --omit=dev --no-audit --no-fund
ENV PLAYWRIGHT_BROWSERS_PATH=/opt/playwright
RUN npx playwright-core install --with-deps chromium --no-shell \
    && chmod -R a+rX /opt/playwright
COPY requirements-headless.txt ./
RUN python3 -m venv /app/.venv && /app/.venv/bin/pip install --no-cache-dir -r requirements-headless.txt
COPY bilibili_drops_miner ./bilibili_drops_miner
COPY headless ./headless
RUN mkdir -p /app/data && chown node:node /app/data && chmod 700 /app/data
USER node
CMD ["python3", "headless/run.py", "--config", "/app/headless/config.json"]
